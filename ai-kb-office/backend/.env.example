# ===== 应用 =====
APP_NAME=AI 知识库办公平台
APP_ENV=dev
DEBUG=true
API_PREFIX=/api

# ===== 数据库 =====
# 生产/本地为 PostgreSQL + pgvector；沙箱中无 Docker 时可切换为 SQLite 验证。
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_kb
# DATABASE_URL=sqlite+aiosqlite:///./ai_kb.db

# ===== 大模型 =====
# provider 取值：ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# OpenAI 兼容云端（如 DeepSeek / 通义 / OpenAI）
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TIMEOUT=60

# ===== 存储 =====
STORAGE_DIR=./storage
